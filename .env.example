# Copy to .env (which is gitignored) and fill in what you need.
# The mock path needs NONE of these.

# ---- Candidate source (LLM) ----
# Backend: "mock" | "manual-file" | "anthropic" | "openai"
MINI_ELF_LLM_BACKEND=mock

# Optional model override (used by anthropic/openai).
# MINI_ELF_LLM_MODEL=claude-sonnet-4-6

# Anthropic: required only if MINI_ELF_LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=

# OpenAI-compatible: required only if MINI_ELF_LLM_BACKEND=openai.
# MINI_ELF_OPENAI_API_KEY takes precedence over OPENAI_API_KEY.
# OPENAI_API_KEY=
# MINI_ELF_OPENAI_API_KEY=
# OPENAI_BASE_URL=            # for OpenAI-compatible endpoints

# ---- Lean verification ----
# Backend: "mock" | "lean-cli" | "leandojo"
MINI_ELF_LEAN_BACKEND=mock

# Override the lean invocation (whitespace-split into argv). If unset, lean-cli
# auto-detects: prefers `lake env lean` when `lake` is on PATH, else `lean`.
# MINI_ELF_LEAN_COMMAND=lake env lean

# Per-tactic timeout in seconds (Lean execution).
MINI_ELF_TACTIC_TIMEOUT=10

# Keep generated temp .lean files for debugging (lean-cli backend).
# MINI_ELF_LEAN_KEEP_TEMP=1

# ---- Misc ----
# Where on-disk LLM proposal cache lives.
# MINI_ELF_CACHE_DIR=.cache

# Optional: where LeanDojo should cache traced repos (future backend).
# LEAN_DOJO_CACHE_DIR=
