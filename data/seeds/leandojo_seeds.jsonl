# Real-LeanDojo seeds for examples/leandojo_mini_repo.
#
# Fill in repo_url + commit AFTER you have pushed examples/leandojo_mini_repo to
# a git host (or pointed LeanDojo at a local clone). See docs/LEANDOJO_SETUP.md.
#
#   - full_name : fully-qualified theorem name LeanDojo targets (here: top-level,
#                 so it equals the theorem name).
#   - file_path : path of the .lean file RELATIVE TO THE REPO ROOT.
#   - initial_state is advisory only; LeanDojo returns the real one from start().
#
# These are NOT verified until you run the leandojo backend on a supported OS
# (Linux/macOS/WSL); LeanDojo does not run on native Windows.
{"theorem_name": "id_of_p", "theorem_statement": "(p : Prop) (h : p) : p", "full_name": "id_of_p", "repo_url": "https://github.com/<YOU>/leandojo_mini_repo", "commit": "<COMMIT_SHA>", "file_path": "MiniDojo.lean", "initial_state": "p : Prop\nh : p\n⊢ p"}
{"theorem_name": "and_comm_toy", "theorem_statement": "(p q : Prop) (h : p ∧ q) : q ∧ p", "full_name": "and_comm_toy", "repo_url": "https://github.com/<YOU>/leandojo_mini_repo", "commit": "<COMMIT_SHA>", "file_path": "MiniDojo.lean", "initial_state": "p q : Prop\nh : p ∧ q\n⊢ q ∧ p"}
