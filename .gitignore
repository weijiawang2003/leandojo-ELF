__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
.venv/
.venv-gpu/
venv/
env/
.env
.DS_Store

# Cached LLM proposals and Lean execution results.
.cache/
data/traces/*.jsonl
!data/traces/.gitkeep

# LeanDojo workspace.
.lean_dojo_cache/
.tmp/

# Stray pytest temp dirs.
pytest-cache-files-*/

# Regenerable lean-cli verification caches (results live in metrics.json).
verification_cache.json

# Local-only Claude Code settings (agents/skills are tracked).
.claude/settings.local.json

# External example repo (its own git repo; manage/clone separately).
examples/leandojo_mini_repo/

# v34 packaging — large / regenerable / noisy artifacts (kept on disk, not tracked).
# Raw per-candidate eval output (the metrics/summary JSON is the committed result).
# Covers predictions.jsonl and val_predictions.jsonl at any depth.
*predictions.jsonl
data/predictions/
# Tokenized corpora + splits — regenerable from data/seeds via build_*.py.
data/processed/
# Build / training / eval stdout.
*.log
# Model weights — regenerable via train_v*.py (not metadata-only, so not tracked).
*.pt
*.pth
# Local Claude Code session state (agents/skills under .claude/ remain tracked).
.claude/projects/
scheduled_tasks.lock

# v39 raw downloads + large corpora (commit generators + fingerprints instead)
data/v39/_raw/
data/v39/corpora/
outputs/v39/**/snapshots/
outputs/v40/**/snapshots/
data/v40/corpora/
data/v40/_raw/
outputs/v41/**/snapshots/
data/v41/corpora/

# v43 premise index — 49MB, deterministic; rebuild via scripts/v43_build_premise_index.py
data/v43/premises/bm25.json
data/v43/premises/premises.json
